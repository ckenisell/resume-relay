<Project>
  <!-- One version number for every edition. -->
  <PropertyGroup>
    <Version>0.3.3</Version>
    <!-- Don't append "+<commit>" to the version the app shows. -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <Product>Resume Relay</Product>
    <Company>Resume Relay</Company>
    <Copyright>Copyright (c) 2026 Chet Kenisell</Copyright>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- Small background program: keep memory use low. -->
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
  </PropertyGroup>
</Project>
