<Project Sdk="Microsoft.NET.Sdk">

  <!-- Everything both editions share: the player watcher, the copy engine, the web API and the page. -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>ResumeRelay</RootNamespace>
  </PropertyGroup>

  <!-- Apple TV (Live Poster): pairing and now playing, from AppleTvControlLibrary (MIT), see third_party. -->
  <ItemGroup>
    <ProjectReference Include="..\..\third_party\AppleTvControlLibrary\src\AppleTv.Hap\AppleTv.Hap.csproj" />
    <ProjectReference Include="..\..\third_party\AppleTvControlLibrary\src\AppleTv.Mrp\AppleTv.Mrp.csproj" />
    <ProjectReference Include="..\..\third_party\AppleTvControlLibrary\src\AppleTV.Companion.Discovery\AppleTV.Companion.Discovery.csproj" />
  </ItemGroup>

  <!-- The TMDB key (Live Poster posters for Apple TV apps' titles), built in from the TMDB_API_KEY environment variable
       (a GitHub Actions secret in release builds). Never in the code; builds without it simply look nothing up. -->
  <ItemGroup Condition="'$(TMDB_API_KEY)' != ''">
    <AssemblyMetadata Include="TmdbApiKey" Value="$(TMDB_API_KEY)" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <!-- The page is compiled in, so a single program file is all that ships. -->
    <EmbeddedResource Include="wwwroot\index.html" LogicalName="index.html" />
    <EmbeddedResource Include="wwwroot\screen.html" LogicalName="screen.html" />
    <EmbeddedResource Include="wwwroot\*.png" LogicalName="web-%(Filename).png" />
    <!-- Live Poster's built-in backgrounds (2160×3840, with a see-through window where the poster shows). -->
    <EmbeddedResource Include="Live\Backgrounds\*.png" LogicalName="bg-%(Filename).png" />
  </ItemGroup>

</Project>
